{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "cypress:verify": "npx cypress verify",
    "cypress:open": "npx cypress open",
    "cypress:run": "npx cypress run",
    "api:generate": "openapi-generator-cli generate -i ../openapi/openapi.yaml -g typescript-angular -o src/app/core/api --additional-properties=ngVersion=22,providedInRoot=true"
  },
  "private": true,
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/jest": "^30.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cypress": "^16.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "cypress@16.1.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true,
    "@openapitools/openapi-generator-cli@2.41.0": true,
    "lmdb@3.5.6": true
  }
}
